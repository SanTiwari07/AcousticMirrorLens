  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">AcousticMirrorAudioController – hollow → clean crossfade + cues</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.AudioTrackAsset hollowLoop {"hint":"Hollow, phasey loop (clean loop mixed with a ~3.5 ms delayed copy)"}'
    - '// @input Asset.AudioTrackAsset cleanLoop {"hint":"Clean loop (same material, no comb filtering)"}'
    - '// @input Asset.AudioTrackAsset lockChime {"hint":"Confirmation chime when the sweet spot locks"}'
    - '// @input Asset.AudioTrackAsset completeChime {"hint":"Completion chime when all reflection points are treated"}'
    - '// @input Asset.AudioTrackAsset ping {"hint":"Subtle ping when an untreated point is out of view"}'
    - '// @input Asset.AudioTrackAsset snapSound {"hint":"Soft thud when a panel snaps onto a reflection point"}'
    - '// @input SceneObject leftMonitor {"hint":"Left studio monitor — hosts one copy of the loops"}'
    - '// @input SceneObject rightMonitor {"hint":"Right studio monitor — hosts one copy of the loops"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float loopVolume = 0.6 {"hint":"Overall loop volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float cueVolume = 0.8 {"hint":"Volume of the chimes and snap cue", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float pingVolume = 0.35 {"hint":"Volume of the subtle out-of-view ping", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float crossfadeSeconds = 1 {"hint":"Seconds to glide between mix steps", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
    - '// @input bool spatialLoops {"hint":"Play the loops as spatial sound from the monitors (needs an Audio Listener on the camera)"}'
    - '// @ui {"widget":"group_end"}'
